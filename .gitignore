# Python cache/build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local config
.venv/
venv/
env/
.env
.envrc

# Local tool caches
.matplotlib/
.ipynb_checkpoints/

# Local secrets
traffic_data/api_key.txt

# Raw, intermediate, and processed data files are large and reproducible/local.
# Keep only .gitkeep files so the expected data directory structure is visible on GitHub.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/interim/**
!data/interim/**/
!data/interim/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

# Legacy data locations.
traffic_data/raw/
traffic_data/processed/
traffic_data/*.dbf
traffic_data/*.shp
traffic_data/*.shx
traffic_data/*.cpg
traffic_data/*.prj

# Editor temporary files
tempCodeRunnerFile.py
