# Python cache/build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local config
.venv/
venv/
env/
.env
.envrc

# Local tool caches
.matplotlib/
.ipynb_checkpoints/
catboost_info/

# Local secrets
traffic_data/api_key.txt

# Raw, intermediate, and processed data files are large and reproducible/local.
# Keep only .gitkeep files so the expected data directory structure is visible on GitHub.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep

# Exception: Seoul admin boundary is small, static reference data (not large/licensed
# raw data), so it's committed for reproducibility. Source has no explicit license;
# repo is currently private. Revisit before making the repo public.
!data/raw/boundary/seoul_admin_boundary.geojson
data/interim/**
!data/interim/**/
!data/interim/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

# Exception: eco-routing 결과 요약표(377B)는 보고서에 그대로 들어가는 결론 수치라
# 매번 재생성하지 않고도 GitHub에서 바로 볼 수 있게 커밋한다. 같은 폴더의 다른
# 산출물(route_comparison_*.csv 수 KB, routes_*.geojson 1~8MB)은 계속 제외한다.
!data/processed/route_scenario_summary.csv

# 학습된 모델 아티팩트도 크고 src/models/*.py로 재현 가능해 원칙적으로는 제외 대상이지만,
# 팀원이 clone 직후 파이프라인 재실행 없이 바로 routing을 돌려볼 수 있도록 최종본만 예외로 커밋한다.
src/models/artifacts/**
!src/models/artifacts/**/
!src/models/artifacts/**/.gitkeep
!src/models/artifacts/model_nb.pkl
!src/models/artifacts/model_stat.pkl

# Legacy data locations.
traffic_data/raw/
traffic_data/processed/
traffic_data/*.dbf
traffic_data/*.shp
traffic_data/*.shx
traffic_data/*.cpg
traffic_data/*.prj

# Editor temporary files
tempCodeRunnerFile.py

# OS / 로컬 도구 찌꺼기 (macOS Finder, R 콘솔 등)
.DS_Store
.Rhistory
.Rapp.history



verification_suite/